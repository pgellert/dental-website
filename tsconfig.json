{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@markdowns": ["./src/markdown"],
      "@components/*": ["./src/components/*"],
      "@content/*": ["./src/content/*"]
    },
    "incremental": true
  },
  "exclude": ["node_modules", ".next", "out", "lib"],
  "include": ["next-env.d.ts", "src/**/*.tsx", "src/**/*.ts"]
}
